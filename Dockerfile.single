FROM alpine:3.20

RUN apk add --no-cache nodejs npm \
    && addgroup -S node \
    && adduser -S -G node node

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY tsconfig.json ./
COPY src/ ./src/
RUN npm run build

USER node
EXPOSE 8000
CMD ["node", "dist/index.js"]
